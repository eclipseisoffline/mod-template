{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    {
      "name": "eclipseisoffline",
      "contact": {
        "homepage": "https://github.com/eclipseisoffline"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/${modrinth_id}",
    "issues": "https://github.com/eclipseisoffline/${github_repository}/issues",
    "sources": "https://github.com/eclipseisoffline/${github_repository}"
  },
  "license": "MIT",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "xyz.eclipseisoffline.modtemplate.client.ModTemplateClient"
    ],
    "main": [
      "xyz.eclipseisoffline.modtemplate.ModTemplate"
    ]
  },
  "mixins": [
    "mod-template.mixins.json",
    {
      "config": "mod-template.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}"
  }
}
